        if (!root.visible || unitZone.__unitKey !== key) {
          unitZone.__unitKey = key;
          buildSkeleton(key);
          const ratings = getPlayerStatRatings();
          PLAYER_STAT_COLUMNS.forEach(([, column], index) => {
            const level = ratings[key + '.' + column];
            ratingTexts[index].setText(PLAYER_STAT_RATING_LABELS[level === undefined ? 1 : level]);
            ratingTexts[index].setColor(PLAYER_STAT_RATING_COLORS[level === undefined ? 1 : level]);
          });
        }
        // 实时血量：当前在场队员的血量合计与历史上限（队员阵亡后上限不回落，
        // 分身落地后上限随之上调，保证读数始终与队伍真实构成一致）
        let hpSum = 0;
        let maxSum = 0;
        squad.members.forEach(member => {
          hpSum += member.hp || 0;
          maxSum += member.maxHp || 0;
        });
        squad.sandboxMaxHp = Math.max(squad.sandboxMaxHp || 0, maxSum);
        // 固定长度血条：填充比例 = 当前血量合计 / 队伍历史上限，不显示数值。
        // 队员阵亡后上限不回落、分身落地后上限随之上调，比例始终与队伍真实构成一致
        const ratio = squad.sandboxMaxHp > 0
          ? Phaser.Math.Clamp(hpSum / squad.sandboxMaxHp, 0, 1)
          : 0;
        hpBar.clear();
        hpBar.fillStyle(0x000000, 0.55);
        hpBar.fillRect(dividerX + 14, -halfH + 12, SANDBOX_HP_BAR_WIDTH, SANDBOX_HP_BAR_HEIGHT);
        hpBar.fillStyle(0x39d353, 0.95);
        hpBar.fillRect(dividerX + 14, -halfH + 12, SANDBOX_HP_BAR_WIDTH * ratio, SANDBOX_HP_BAR_HEIGHT);
        root.setVisible(true);
