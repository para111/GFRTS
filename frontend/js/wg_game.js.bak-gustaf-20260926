      // 未出兵时小队不显示；出生动画播放期间保持显示，避免中途点击把出生动画藏起来
      playerSquads.forEach(squad => {
        setPlayerSquadVisible(squad, squad.unit.isSpawned || squad.spawnAnimation !== null);
